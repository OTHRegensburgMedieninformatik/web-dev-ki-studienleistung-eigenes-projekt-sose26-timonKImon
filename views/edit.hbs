<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .scratched-overlay {
            position: fixed;
            inset: 0;
            background-image: url("https://www.transparenttextures.com/patterns/stardust.png");
            opacity: 0.03;
            pointer-events: none;
            z-index: 9999;
        }
        .admin-sidebar {
            height: calc(100vh - 68px);
        }
        .form-card {
            border: 4px solid #002147;
            box-shadow: 6px 6px 0px 0px #ff5717;
        }
        .form-card-secondary {
            border: 4px solid #ff5717;
            box-shadow: 6px 6px 0px 0px #002147;
        }
        .nav-link-active {
            background-color: #ff5717;
            color: #002147;
        }
        input, select, textarea {
            background-color: #1c1b1b !important;
            border: 2px solid #44474e !important;
            color: #e5e2e1 !important;
        }
        input:focus, select:focus, textarea:focus {
            border-color: #aec7f6 !important;
            ring: 0 !important;
            outline: none !important;
        }
    </style>
</head>
{{> menu id="edit"}}
<body class="bg-background text-on-background font-body-md overflow-x-hidden">
<div class="scratched-overlay">
</div>
<div class="flex">
<!-- Sidebar -->
<!-- Main Content -->
<main class="flex-1 p-gutter max-w-5xl mx-auto space-y-stack-lg">
<!-- Section: Menu -->
<section class="scroll-mt-24 space-y-stack-md" id="menu">
<div class="flex items-baseline gap-4 mb-4">
<h2 class="font-display-lg text-display-lg text-primary uppercase">Speisekarte</h2>
<span class="font-label-md text-outline uppercase">Verwalten</span>
</div>
<div class="grid md:grid-cols-2 gap-8">
<!-- Add Item -->
    {{> editMenu}}
<!-- Delete/Edit List -->
    {{> deleteMenu}}
</section>
<!-- Section: Events -->
<section class="scroll-mt-24 space-y-stack-md" id="events">
<div class="flex items-baseline gap-4 mb-4">
<h2 class="font-display-lg text-display-lg text-primary uppercase">Events</h2>
<span class="font-label-md text-outline uppercase">Planung</span>
</div>
    {{> addEvents}}

    {{> deleteEvents}}
</div></div>
</section>
<!-- Section: Reservations -->
<section class="scroll-mt-24 space-y-stack-md" id="reservations">
<div class="flex items-baseline gap-4 mb-4">
<h2 class="font-display-lg text-display-lg text-primary uppercase">Reservierungen</h2>
<span class="font-label-md text-outline uppercase">Gästeliste</span>
</div>
<div class="form-card bg-surface-container overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-primary-container text-primary font-label-md uppercase">
<th class="p-4 border-r border-primary/20">Name</th>
<th class="p-4 border-r border-primary/20">Datum</th>
<th class="p-4 border-r border-primary/20">Uhrzeit</th>
<th class="p-4 border-r border-primary/20">Anzahl Personen</th>
<th class="p-4 border-r border-primary/20">Status</th>
<th class="p-4 text-center">Aktion</th>
</tr>
</thead>
<tbody class="font-body-md">
{{#each reservierungen}}
<tr class="border-b border-outline/10 hover:bg-surface-container-high transition-colors">
<td class="p-4">{{this.name}}</td>
<td class="p-4">{{this.datum}}</td>
<td class="p-4">{{this.uhrzeit}}</td>
<td class="p-4">{{this.anzpers}}</td>
<td class="p-4">{{this.status}}</td>
<td class="p-4">
    {{#if (eq this.status "offen")}}
    <form action="/reservierung/{{this.id}}/annehmen" method="POST">
        <input name="id" type="hidden" value="{{this.id}}"/>
        <button class="bg-tertiary text-on-tertiary px-3 py-1 font-label-sm uppercase" type="submit">Annehmen</button>
    </form>
    {{/if}}
</td>
</tr>
{{/each}}
</tbody>
</table>
</div>
</div>
</section>
</main>
</div>
<script>
        // Simple scroll spy & active link update
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.admin-sidebar a');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (pageYOffset >= (sectionTop - 150)) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('nav-link-active', 'text-primary');
                link.classList.add('text-on-surface');
                if (link.getAttribute('href').includes(current)) {
                    link.classList.add('nav-link-active', 'text-primary');
                    link.classList.remove('text-on-surface');
                }
            });
        });

        // Click handler for smooth scroll
        navLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = link.getAttribute('href');
                document.querySelector(targetId).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
    </script>
    {{> footer}}
</body></html>