<!DOCTYPE html>

<html class="dark" lang="de"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Hanken+Grotesk:wght@400;700&amp;family=JetBrains+Mono:wght@500&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 48;
        }
        .college-border {
            border-left: 8px solid #ff5717;
        }
        .focus-ring:focus {
            outline: none;
            border-color: #aec7f6;
            box-shadow: 0 0 0 4px rgba(174, 199, 246, 0.2);
        }
        /* Varsity Style Hard Shadow for Headline */
        .varsity-shadow {
            color: #ff5717; /* Secondary container orange */
            text-shadow: 6px 6px 0px #002147; /* Primary container dark blue offset */
        }
    </style>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary-fixed": "#ffdbd0",
                        "on-error": "#690005",
                        "outline-variant": "#44474e",
                        "on-primary": "#143057",
                        "on-surface-variant": "#c4c6cf",
                        "tertiary-container": "#002628",
                        "on-secondary-fixed": "#3a0b00",
                        "on-tertiary-fixed-variant": "#004f53",
                        "on-secondary-fixed-variant": "#842500",
                        "error-container": "#93000a",
                        "error": "#ffb4ab",
                        "on-background": "#e5e2e1",
                        "surface": "#131313",
                        "tertiary": "#00dce5",
                        "on-secondary": "#5e1700",
                        "inverse-on-surface": "#313030",
                        "surface-container-high": "#2a2a2a",
                        "primary-container": "#002147",
                        "surface-container": "#201f1f",
                        "secondary-container": "#ff5717",
                        "on-tertiary": "#003739",
                        "inverse-primary": "#465f88",
                        "tertiary-fixed-dim": "#00dce5",
                        "surface-dim": "#131313",
                        "inverse-surface": "#e5e2e1",
                        "surface-container-lowest": "#0e0e0e",
                        "background": "#131313",
                        "secondary-fixed-dim": "#ffb59e",
                        "on-tertiary-container": "#00989e",
                        "on-secondary-container": "#521300",
                        "surface-variant": "#353534",
                        "on-primary-fixed-variant": "#2d476f",
                        "on-primary-container": "#708ab5",
                        "on-tertiary-fixed": "#002021",
                        "surface-container-low": "#1c1b1b",
                        "primary-fixed": "#d6e3ff",
                        "on-primary-fixed": "#001b3d",
                        "tertiary-fixed": "#63f7ff",
                        "surface-container-highest": "#353534",
                        "primary": "#aec7f6",
                        "on-error-container": "#ffdad6",
                        "surface-tint": "#aec7f6",
                        "on-surface": "#e5e2e1",
                        "secondary": "#ffb59e",
                        "outline": "#8e9099",
                        "surface-bright": "#3a3939",
                        "primary-fixed-dim": "#aec7f6"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "48px",
                        "margin-desktop": "48px",
                        "gutter": "20px",
                        "stack-md": "24px",
                        "margin-mobile": "16px",
                        "base": "4px",
                        "stack-sm": "8px"
                    },
                    "fontFamily": {
                        "label-sm": ["JetBrains Mono"],
                        "body-lg": ["Hanken Grotesk"],
                        "headline-md": ["Anton"],
                        "label-md": ["JetBrains Mono"],
                        "headline-lg": ["Anton"],
                        "headline-lg-mobile": ["Anton"],
                        "display-lg": ["Anton"],
                        "body-md": ["Hanken Grotesk"]
                    },
                    "fontSize": {
                        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "headline-md": ["32px", {"lineHeight": "36px", "fontWeight": "400"}],
                        "label-md": ["14px", {"lineHeight": "20px", "fontWeight": "500"}],
                        "headline-lg": ["48px", {"lineHeight": "52px", "letterSpacing": "0.01em", "fontWeight": "400"}],
                        "headline-lg-mobile": ["36px", {"lineHeight": "40px", "fontWeight": "400"}],
                        "display-lg": ["80px", {"lineHeight": "80px", "letterSpacing": "0.02em", "fontWeight": "400"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
</head>
<body class="bg-background text-on-background font-body-md">
    {{> menu id="Reservieren"}}
<main class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-16 md:py-24">
<div class="max-w-4xl mx-auto">
<!-- Header Section -->
<div class="mb-16 pl-8">
<h1 class="font-display-lg text-6xl md:text-display-lg uppercase tracking-tighter leading-none mb-4 varsity-shadow">RESERVIEREN</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
                Plane dein Team-Event, den nächsten Beer Pong Turniersieg oder einfach einen entspannten Abend. Schnell, unkompliziert, Frathouse Style.
            </p>
</div>
<!-- Reservation Form -->
<div class="bg-surface-container rounded-xl p-8 md:p-12 border border-outline-variant/20 shadow-2xl shadow-hard-blue">
    {{> reservierenForm}}
</div>
<!-- Phone Fallback -->
<div class="mt-20 text-center">
<p class="font-headline-md text-headline-md uppercase text-on-background">
                    Oder einfach anrufen unter: <span class="text-secondary-container">0175/110011001</span>
</p>
</div>
</div>
</main>
{{> footer}}
<script>
    document.getElementById('reservationForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const submitBtn = e.target.querySelector('button[type="submit"]');
        const originalContent = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> VERARBEITE...';
        
        setTimeout(() => {
            submitBtn.classList.remove('bg-secondary-container');
            submitBtn.classList.add('bg-tertiary', 'text-on-tertiary');
            submitBtn.innerHTML = '<span class="material-symbols-outlined">check_circle</span> ANFRAGE GESENDET!';
            
            setTimeout(() => {
                submitBtn.classList.add('bg-secondary-container');
                submitBtn.classList.remove('bg-tertiary', 'text-on-tertiary');
                submitBtn.innerHTML = originalContent;
                submitBtn.disabled = false;
                e.target.reset();
            }, 3000);
        }, 1500);
    });
</script>
</body></html>
