<!DOCTYPE html>

<html class="dark" lang="de"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>KARTE | FRATHOUSE REGENSBURG</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Hanken+Grotesk:wght@400;700&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-surface-variant": "#c4c6cf",
                    "inverse-on-surface": "#313030",
                    "on-tertiary": "#003739",
                    "surface-variant": "#353534",
                    "on-surface": "#e5e2e1",
                    "on-error": "#690005",
                    "tertiary-fixed": "#63f7ff",
                    "surface-container-lowest": "#0e0e0e",
                    "primary": "#aec7f6",
                    "tertiary-container": "#002628",
                    "error-container": "#93000a",
                    "outline-variant": "#44474e",
                    "on-secondary-fixed-variant": "#842500",
                    "inverse-surface": "#e5e2e1",
                    "on-background": "#e5e2e1",
                    "on-secondary-container": "#521300",
                    "surface-tint": "#aec7f6",
                    "primary-fixed": "#d6e3ff",
                    "on-primary": "#143057",
                    "on-tertiary-container": "#00989e",
                    "on-secondary-fixed": "#3a0b00",
                    "outline": "#8e9099",
                    "on-primary-fixed": "#001b3d",
                    "tertiary-fixed-dim": "#00dce5",
                    "surface-bright": "#3a3939",
                    "on-secondary": "#5e1700",
                    "error": "#ffb4ab",
                    "surface": "#131313",
                    "secondary-fixed-dim": "#ffb59e",
                    "on-tertiary-fixed-variant": "#004f53",
                    "on-primary-fixed-variant": "#2d476f",
                    "secondary-container": "#ff5717",
                    "primary-container": "#002147",
                    "on-error-container": "#ffdad6",
                    "surface-container-highest": "#353534",
                    "inverse-primary": "#465f88",
                    "secondary": "#ffb59e",
                    "tertiary": "#00dce5",
                    "surface-dim": "#131313",
                    "surface-container-high": "#2a2a2a",
                    "secondary-fixed": "#ffdbd0",
                    "primary-fixed-dim": "#aec7f6",
                    "on-primary-container": "#708ab5",
                    "on-tertiary-fixed": "#002021",
                    "surface-container-low": "#1c1b1b",
                    "background": "#131313",
                    "surface-container": "#201f1f"
            },
            "borderRadius": {
                    "DEFAULT": "0px",
                    "lg": "0px",
                    "xl": "0px",
                    "full": "9999px"
            },
            "spacing": {
                    "stack-sm": "8px",
                    "base": "4px",
                    "margin-desktop": "48px",
                    "stack-md": "24px",
                    "margin-mobile": "16px",
                    "stack-lg": "48px",
                    "gutter": "20px"
            },
            "fontFamily": {
                    "label-sm": ["JetBrains Mono"],
                    "headline-lg-mobile": ["Anton"],
                    "label-md": ["JetBrains Mono"],
                    "headline-md": ["Anton"],
                    "display-lg": ["Anton"],
                    "headline-lg": ["Anton"],
                    "body-md": ["Hanken Grotesk"],
                    "body-lg": ["Hanken Grotesk"]
            },
            "fontSize": {
                    "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],
                    "headline-lg-mobile": ["36px", {"lineHeight": "40px", "fontWeight": "400"}],
                    "label-md": ["14px", {"lineHeight": "20px", "fontWeight": "500"}],
                    "headline-md": ["32px", {"lineHeight": "36px", "fontWeight": "400"}],
                    "display-lg": ["80px", {"lineHeight": "80px", "letterSpacing": "0.02em", "fontWeight": "400"}],
                    "headline-lg": ["48px", {"lineHeight": "52px", "letterSpacing": "0.01em", "fontWeight": "400"}],
                    "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .scratched-overlay {
            position: fixed;
            inset: 0;
            background-image: url("https://www.transparenttextures.com/patterns/stardust.png");
            opacity: 0.03;
            pointer-events: none;
            z-index: 9999;
        }
        .hard-shadow {
            box-shadow: 6px 6px 0px 0px #ff5717;
        }
        .hard-shadow-navy {
            box-shadow: 6px 6px 0px 0px #002147;
        }
        .sticker-rotate {
            transform: rotate(-1.5deg);
        }
        .menu-item-border {
            border-bottom: 1px dashed #44474e;
        }
        .varsity-headline {
            color: #002147;
            -webkit-text-stroke: 2px #ff5717;
            paint-order: stroke fill;
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md overflow-x-hidden">
<div class="scratched-overlay"></div>

    {{> menu id="getränkekarte"}}

    <main class="max-w-4xl mx-auto px-gutter py-stack-lg min-h-screen">
<!-- Hero Section -->
<section class="relative mb-stack-lg flex flex-col items-start">
<div class="absolute -top-12 -left-8 opacity-10 pointer-events-none select-none">
<h2 class="font-display-lg text-[120px] leading-none text-primary-container">VARSITY</h2>
</div>
<h1 class="font-display-lg text-display-lg md:text-[180px] leading-[0.8] uppercase varsity-headline mb-4 z-10 drop-shadow-[4px_4px_0_#ff5717]">
                GETRÄNKE
            </h1>
<div class="bg-secondary-container px-4 py-1 sticker-rotate z-20 inline-block">
<span class="font-label-md text-on-secondary-container uppercase font-bold tracking-widest">VARSITY SELECTION VOL. II</span>
</div>
</section>
<!-- Dynamic Menu Content -->
<div class="space-y-12">
            {{#each sortedMenu}}
                {{#unless (eq name "Hungrig?")}}
                <section class="bg-surface-container border-4 border-secondary-container p-stack-md hard-shadow-navy" id="{{@key}}">
<header class="flex justify-between items-end mb-stack-md border-b-2 border-secondary-container pb-2">
<h2 class="font-headline-lg text-headline-lg uppercase text-secondary-container">{{name}}</h2>
</header>
<div class="space-y-6">
                        {{#each item}}
                        <div class="menu-item-border pb-4 flex justify-between items-start group">
<div class="flex-1 pr-4">
<h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors uppercase">{{item}}</h3>
                                {{#if inhalt}}
                                <p class="font-body-md text-on-surface-variant italic">{{inhalt}}</p>
                                {{/if}}
                            </div>
<span class="font-headline-md text-headline-md text-secondary-container">{{preis}}€</span>
</div>
                        {{/each}}
                    </div>
</section>
                {{/unless}}
            {{/each}}

            <!-- HUNGRIG? (FOOD SECTION) - Special Highlighted Handling -->
            {{#each sortedMenu}}
                {{#if (eq name "Hungrig?")}}
                <section class="bg-secondary-container border-4 border-on-secondary-container p-stack-md hard-shadow sticker-rotate relative overflow-hidden" id="essen">
<div class="absolute top-0 right-0 bg-primary-container text-primary px-4 py-1 font-label-sm uppercase font-bold">Hot &amp; Fresh</div>
<header class="flex justify-between items-end mb-stack-md border-b-4 border-on-secondary-container pb-2">
<h2 class="font-headline-lg text-headline-lg uppercase text-on-secondary-container">{{name}}</h2>
<span class="font-label-sm text-on-secondary-container uppercase pb-1 font-bold">Kitchen open til 2am</span>
</header>
<div class="space-y-8">
                        {{#each item}}
                        <div class="flex justify-between items-start group">
<div class="flex-1 pr-4">
<h3 class="font-headline-md text-headline-md text-on-secondary-container group-hover:text-primary transition-colors uppercase">{{item}}</h3>
                                {{#if inhalt}}
                                <p class="font-body-md text-on-secondary-container/80 italic">{{inhalt}}</p>
                                {{/if}}
                            </div>
<div class="bg-primary-container p-2 border-2 border-on-secondary-container">
<span class="font-headline-md text-headline-md text-primary leading-none">{{preis}}€</span>
</div>
</div>
                        {{/each}}
                    </div>
</section>
                {{/if}}
            {{/each}}
        </div>
</main>

    {{> footer}}

    <script>
        // Micro-interaction: Subtle flicker for secondary accents
        const flickerElements = document.querySelectorAll('.text-secondary-container');
        setInterval(() => {
            const el = flickerElements[Math.floor(Math.random() * flickerElements.length)];
            if (el) {
                el.style.opacity = '0.8';
                setTimeout(() => {
                    el.style.opacity = '1';
                }, 80);
            }
        }, 4000);

        // Smooth scroll for nav items
        document.querySelectorAll('nav a').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href && href.startsWith('#')) {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });
                    }
                }
            });
        });
    </script>
</body></html>
