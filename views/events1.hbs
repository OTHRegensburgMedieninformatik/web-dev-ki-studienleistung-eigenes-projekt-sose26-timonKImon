{{> menu id="Events"}}

<div class="card mt-3">
  <div class="card-header">
    Wöchentliche Specials
  </div>
  <div class="card-body">
    <table class="table table-bordered">
      <thead>
        <th scope="col">Montag</th>
        <th scope="col">Dienstag</th>
        <th scope="col">Mittwoch</th>
        <th scope="col">Donnerstag</th>
        <th scope="col">Freitag</th>
        <th scope="col">Samstag</th>
        <th scope="col">Sonntag</th>
      </thead>
      <tbody>
        <td>Geschlossen</td>
        <td>Special 1</td>
        <td>Special 2</td>
        <td>Special 3</td>
        <td>Special 4</td>
        <td>Special 5</td>
        <td>Geschlossen</td>
      </tbody>
    </table>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header">
    Events
  </div>
  <div class="card-body">
      {{#each allevents}}
      <h5>{{datum}} - {{name}}</h5>
      {{/each}}
  </div>
</div>
