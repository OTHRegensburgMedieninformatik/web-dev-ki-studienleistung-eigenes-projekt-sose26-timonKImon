                      "surface-tint": "#aec7f6",
                      "secondary-fixed-dim": "#ffb59e",
                      "on-surface": "#e5e2e1",
                      "on-tertiary-container": "#00989e",
                      "on-primary": "#143057",
                      "on-error": "#690005",
                      "inverse-surface": "#e5e2e1",
                      "outline-variant": "#44474e",
                      "surface-container-high": "#2a2a2a",
                      "on-secondary-container": "#521300",
                      "error": "#ffb4ab",
                      "primary": "#aec7f6",
                      "on-error-container": "#ffdad6",
                      "tertiary-container": "#002628",
                      "surface-dim": "#131313",
                      "secondary-fixed": "#ffdbd0",
                      "on-tertiary-fixed": "#002021",
                      "background": "#131313",
                      "surface-container-low": "#1c1b1b",
                      "on-background": "#e5e2e1",
                      "primary-container": "#002147",
                      "secondary-container": "#ff5717",
                      "on-surface-variant": "#c4c6cf",
                      "tertiary-fixed": "#63f7ff",
                      "surface-container": "#201f1f",
                      "on-primary-container": "#708ab5",
                      "on-primary-fixed-variant": "#2d476f",
                      "surface-container-lowest": "#0e0e0e",
                      "outline": "#8e9099",
                      "surface-bright": "#3a3939",
                      "primary-fixed-dim": "#aec7f6",
                      "primary-fixed": "#d6e3ff",
                      "on-tertiary": "#003739",
                      "error-container": "#93000a",
                      "on-tertiary-fixed-variant": "#004f53",
                      "inverse-on-surface": "#313030",
                      "surface-container-highest": "#353534",
                      "on-secondary": "#5e1700",
                      "tertiary-fixed-dim": "#00dce5",
                      "tertiary": "#00dce5",
                      "secondary": "#ffb59e",
                      "on-primary-fixed": "#001b3d",
                      "surface-variant": "#353534"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "stack-md": "24px",
                      "base": "4px",
                      "stack-sm": "8px",
                      "margin-mobile": "16px",
                      "margin-desktop": "48px",
                      "gutter": "20px",
                      "stack-lg": "48px"
              },
              "fontFamily": {
                      "headline-md": ["Anton"],
                      "headline-lg": ["Anton"],
                      "label-md": ["JetBrains Mono"],
                      "body-md": ["Hanken Grotesk"],
                      "body-lg": ["Hanken Grotesk"],
                      "label-sm": ["JetBrains Mono"],
                      "display-lg": ["Anton"],
                      "headline-lg-mobile": ["Anton"]
              },
              "fontSize": {
                      "headline-md": ["32px", {"lineHeight": "36px", "fontWeight": "400"}],
                      "headline-lg": ["48px", {"lineHeight": "52px", "letterSpacing": "0.01em", "fontWeight": "400"}],
                      "label-md": ["14px", {"lineHeight": "20px", "fontWeight": "500"}],
                      "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                      "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],
                      "display-lg": ["80px", {"lineHeight": "80px", "letterSpacing": "0.02em", "fontWeight": "400"}],
                      "headline-lg-mobile": ["36px", {"lineHeight": "40px", "fontWeight": "400"}]
              }
            },
          },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 48;
        }
        
        .varsity-button {
            transition: all 0.15s ease-in-out;
        }
        
        .varsity-button:active {
            transform: translate(4px, 4px);
            box-shadow: none !important;
        }

        .scratched-overlay {
            background-image: url("https://www.transparenttextures.com/patterns/scratched-metal.png");
            opacity: 0.05;
            pointer-events: none;
        }

        .input-varsity:focus {
            outline: none;
            border-color: #ff5717;
            box-shadow: 0 0 12px rgba(255, 87, 23, 0.3);
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen relative overflow-x-hidden font-body-md selection:bg-secondary-container selection:text-white">
<!-- Distress Overlay -->
<div class="fixed inset-0 scratched-overlay z-50"></div>
<!-- Background Pattern Effect -->
<div class="fixed inset-0 opacity-10 pointer-events-none z-0">
<div class="absolute inset-0" style="background-image: radial-gradient(#ff5717 1px, transparent 1px); background-size: 32px 32px;"></div>
</div>
<!-- Header Section -->
<header class="relative z-10 w-full py-stack-md flex justify-center items-center">
<div class="flex flex-col items-center">
<h1 class="font-display-lg text-display-lg uppercase tracking-tighter transform text-primary">
                FRATHOUSE
            </h1>
<p class="font-label-md text-label-md text-primary mt-base tracking-widest uppercase bg-surface-container px-4 py-1 border-2 border-primary transform rotate-1 shadow-[4px_4px_0px_0px_#aec7f6]">
                Goes Underground
            </p>
</div>
</header>
<main class="relative z-10 max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg flex flex-col md:flex-row gap-gutter">
<!-- Login Section -->
    {{> login}}
<!-- Registration Section -->
    {{> register}}
</main>
   
