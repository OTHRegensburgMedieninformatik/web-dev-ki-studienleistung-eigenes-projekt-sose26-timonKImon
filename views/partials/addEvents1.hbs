<form action="/edit/addEv" method="POST">
    <div class="row">
        <div class="mb-3 col-4">
            <label for="inputName" class="form-label">Name</label>
            <input placeholder="Bierpongtunier" type="text" className="form-control" id="inputName" name="name">
        </div>
        <div class="mb-3 col-4">
            <label for="inputInhalt" class="form-label">Datum</label>
            <input placeholder="25.01.2031" type="date" className="form-control" id="inputDatum" name="datum">
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Hinzufügen</button>
</form>
