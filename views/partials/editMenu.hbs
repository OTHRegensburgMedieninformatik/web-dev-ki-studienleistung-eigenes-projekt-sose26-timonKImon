<form action="/edit/add" method="POST">
    <div class="row">
        <div class="mb-3 col-4">
            <label for="inputName" class="form-label">Name</label>
            <input placeholder="Touchdown" type="text" className="form-control" id="inputName" name="name">
        </div>
        <div class="mb-3 col-4">
            <label for="inputInhalt" class="form-label">Inhalt</label>
            <input placeholder="Vodka, Apricot Brandy ..." type="text" className="form-control" id="inputInhalt" name="inhalt">
        </div>
        <div class="mb-3 col-4">
            <label for="inputPreis" class="form-label">Preis</label>
            <input placeholder="9.00" type="number" className="form-control" id="inputPreis" name="preis">
        </div>
        <div class="col-md-3">
        <label class="input-group-text" for="inputGroupSelect01">Kategorie</label>
        <select class="form-select" id="inputGroupSelectKategorie" name="kategorie">
            <option selected>auswählen...</option>
            <option value="Cocktails" name="kategorie">Cocktails</option>
            <option value="Longdrinks" name="kategorie">Longdrinks</option>
            <option value="Bier" name="kategorie">Bier</option>
            <option value="Shots" name="kategorie">Shots</option>
            <option value="Alkoholfrei" name="kategorie">Alkoholfrei</option>
        </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Hinzufügen</button>
</form>
